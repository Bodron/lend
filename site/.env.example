# true: live API; false: local development API
SITE_USE_PRODUCTION_BACKEND=false
SITE_PRODUCTION_BACKEND_API_URL=https://lend.bcmenu.ro/api

# Used when SITE_USE_PRODUCTION_BACKEND=false outside Docker.
# Docker Compose sets BACKEND_API_URL=http://api:3000/api automatically.
BACKEND_API_URL=http://localhost:3000/api

# Store listing URLs used by the badges on /download and the mobile-width screen.
# Until configured, each badge explains that its store link is coming soon.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=
